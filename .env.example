# VerifEye — Environment Variables

# Port the Express server listens on (default: 3000)
PORT=3000

# APP_URL: The public URL of your deployment (used for tracking pixels / self-referential links)
APP_URL="https://yourdomain.com"

# JWT secret — change this in production!
JWT_SECRET="supersecret_verifeye123!"

# ---------------------------------------------------------------------------
# Real Email Verification (Layer 6 — optional)
# If these are not set, deep verification is disabled gracefully.
# ---------------------------------------------------------------------------

# SMTP host for sending verification probe emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Use a Gmail App Password (not your main password!)
# https://myaccount.google.com/apppasswords
SMTP_USER=your-app@gmail.com
SMTP_PASS=your-16-char-app-password

# Display name for outgoing probe emails
SMTP_FROM_NAME=VerifEye Verification
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# Abstract API — Email Reputation (optional but strongly recommended)
# Used for Yahoo and educational domain verification where SMTP probing fails.
# Product:  Email Reputation API  (NOT "Email Validation" — different product!)
# Endpoint: https://emailreputation.abstractapi.com/v1/
# Docs:     https://docs.abstractapi.com/api/email-reputation
# Dashboard:https://app.abstractapi.com/api/email-reputation/tester
# Free tier: 100 requests / month
# ---------------------------------------------------------------------------
ABSTRACT_API_KEY=your_abstract_api_key_here
